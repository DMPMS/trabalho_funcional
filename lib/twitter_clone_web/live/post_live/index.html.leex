<h1>Timeline</h1>

<%= if @live_action in [:new, :edit] do %>
  <%= live_modal @socket, TwitterCloneWeb.PostLive.FormComponent,
    id: @post.id || :new,
    title: @page_title,
    action: @live_action,
    post: @post,
    current_user: @current_user,
    return_to: Routes.post_index_path(@socket, :index) %>
<% end %>

<span><%= live_patch "Nova Publicação", to: Routes.post_index_path(@socket, :new) %></span>

<div id="posts" phx-update="prepend">
  <%= for p <- @posts do %>
    <%= live_component @socket,
      TwitterCloneWeb.PostLive.PostComponent,
      id: p.post.id,
      post: p.post,
      user_name: p.user_name,
      comments_count: p.comments_count
    %>
  <% end %>
</div>
