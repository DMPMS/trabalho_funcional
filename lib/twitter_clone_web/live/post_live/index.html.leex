<%= if @live_action in [:new, :edit] do %>
  <%= live_modal @socket, TwitterCloneWeb.PostLive.FormComponent,
    id: @post.id || :new,
    title: @page_title,
    action: @live_action,
    post: @post,
    current_user: @current_user,
    return_to: Routes.post_index_path(@socket, :index) %>
<% end %>

<div class="min-h-screen flex justify-center">
  <div class="m-4 w-[800px]">
    <h2 class="text-2xl font-semibold text-gray-700 text-center mb-4">Timeline</h2>

    <div class="flex justify-between mb-4">
      <%= live_patch "Nova Publicação", to: Routes.post_index_path(@socket, :new), class: "inline-block p-6 py-2 text-white rounded-xl bg-blue-500 hover:bg-blue-600 transition duration-300 font-semibold" %>
      <a href="/logout" class="inline-block p-6 py-2 text-white rounded-xl bg-red-500 hover:bg-red-600 transition duration-300 font-semibold">Sair</a>
    </div>

    <div id="posts" phx-update="prepend" class="flex flex-col gap-1">
      <%= for p <- @posts do %>
        <%= live_component @socket,
          TwitterCloneWeb.PostLive.PostComponent,
          id: p.post.id,
          post: p.post,
          user_name: p.user_name,
          comments_count: p.comments_count,
          user_logged_username: @current_user.username
        %>
      <% end %>
    </div>
  </div>
</div>
