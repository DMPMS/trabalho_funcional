<h2><%= @title %></h2>

<%= f = form_for @changeset, "#",
  id: "comment-form",
  phx_target: @myself,
  phx_change: "validate",
  phx_submit: "save" %>

  <%= label f, :body %>
  <%= text_input f, :body %>

  <%= label f, :post_id %>
  <%= text_input f, :post_id %>

  <%= error_tag f, :body %>

  <%= submit "Salvar", phx_disable_with: "Salvando..." %>
</form>
