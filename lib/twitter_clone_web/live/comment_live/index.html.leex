<%= if @live_action in [:new, :edit] do %>
  <%= live_modal @socket, TwitterCloneWeb.CommentLive.FormComponent,
    id: @comment.id || :new,
    title: @page_title,
    action: @live_action,
    comment: @comment,
    current_user: @current_user,
    return_to: Routes.comment_index_path(@socket, :index, @post_id) %>
<% end %>

<div class="min-h-screen flex justify-center">
  <div class="m-4 w-[800px]">
    <h2 class="text-2xl font-semibold text-gray-700 text-center mb-4">Comentários</h2>

    <div class="flex justify-between mb-4">
      <div class="flex gap-1">
        <%= live_patch "Voltar", to: Routes.post_index_path(@socket, :index), class: "inline-block p-6 py-2 text-white rounded-xl bg-blue-500 hover:bg-blue-600 transition duration-300 font-semibold" %>
        <%= live_patch "Novo Comentário", to: Routes.comment_index_path(@socket, :new, @post_id), class: "inline-block p-6 py-2 text-white rounded-xl bg-blue-500 hover:bg-blue-600 transition duration-300 font-semibold" %>
      </div>
      <a href="/logout" class="inline-block p-6 py-2 text-white rounded-xl bg-red-500 hover:bg-red-600 transition duration-300 font-semibold">Sair</a>
    </div>

    <div id="comments" phx-update="prepend" class="flex flex-col gap-1">
      <%= for c <- @comments do %>
        <%= live_component @socket,
          TwitterCloneWeb.CommentLive.CommentComponent,
          id: c.comment.id,
          user_name: c.user_name,
          comment: c.comment
        %>
      <% end %>
    </div>
  </div>
</div>
