 <div class="max-w-md mx-auto bg-white rounded-2xl shadow-lg p-8 space-y-6">
  <h2 class="text-2xl font-semibold text-gray-700 mb-6 text-center">Crie sua Conta</h2>
  <%= form_for @changeset, Routes.user_path(@conn, :create), fn f -> %>
    <div class="mb-4">
      <%= label f, :username, class: "block mb-2 text-sm font-medium text-gray-700" %>
      <%= text_input f, :username, class: "w-full p-3 border border-gray-300 rounded-2xl focus:ring-2 focus:ring-blue-500 focus:outline-none transition duration-200" %>
      <%= error_tag f, :username %>
    </div>
    <div class="mb-4">
      <%= label f, :password, class: "block mb-2 text-sm font-medium text-gray-700" %>
      <%= password_input f, :password, class: "w-full p-3 border border-gray-300 rounded-2xl focus:ring-2 focus:ring-blue-500 focus:outline-none transition duration-200" %>
      <%= error_tag f, :password %>
    </div>
    <div class="mb-4">
      <%= label f, :role_key, class: "block mb-2 text-sm font-medium text-gray-700" %>
      <%= text_input f, :role_key, class: "w-full p-3 border border-gray-300 rounded-2xl focus:ring-2 focus:ring-blue-500 focus:outline-none transition duration-200" %>
      <%= error_tag f, :role_key %>
    </div>
    <div>
      <%= submit "Cadastrar", class: "w-full px-4 py-3 bg-green-500 text-white rounded-2xl hover:bg-green-600 transition duration-300 font-semibold" %>
    </div>
  <% end %>
  <div class="text-center mt-4">
    <a href="/login" class="text-blue-600 hover:text-blue-700 hover:underline text-sm font-medium">Já tem uma conta? Faça login!</a>
  </div>
</div>
