<div class="min-h-screen flex items-center justify-center">
  <div class="m-4 bg-white rounded-xl p-6 w-[400px]">
    <div class="mb-4 flex items-center justify-center gap-4">
      <img src="https://t.ctcdn.com.br/IztTNlvssS2kgmPP4QPFV5-WKL8=/1080x1080/smart/i489929.jpeg" class="w-12 h-12 rounded-full hide-below-350">
      <h2 class="text-2xl font-semibold text-gray-700 text-center">Entrar</h2>
      <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQHy8QNdeau81pJfcc9B6K0BIJ1YAT6r3JG3w&s" class="w-12 h-12 rounded-full hide-below-350">
    </div>
    <%= form_for @conn, Routes.session_path(@conn, :create), [as: :session], fn f -> %>
      <div class="mb-4">
        <%= label f, :usuário, class: "block mb-2 text-sm font-medium text-gray-700" %>
        <%= text_input f, :username, class: "w-full py-2 border border-gray-300 rounded-xl transition duration-300" %>
      </div>
      <div class="mb-4">
        <%= label f, :senha, class: "block mb-2 text-sm font-medium text-gray-700" %>
        <%= password_input f, :password, class: "w-full py-2 border border-gray-300 rounded-xl transition duration-300" %>
      </div>
      <div class="mb-4">
        <%= submit "Entrar", class: "w-full py-2 bg-blue-500 text-white rounded-xl hover:bg-blue-600 transition duration-300 font-semibold" %>
      </div>
    <% end %>
    <div class="text-center">
      <a href="/register" class="text-blue-500 hover:underline text-sm">Ainda não tem uma conta?
      Crie uma agora!</a>
    </div>
  </div>
</div>
